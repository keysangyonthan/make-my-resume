rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own data:
    // their profile (users/{uid}) and their resumes (users/{uid}/resumes/*).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /resumes/{resumeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
